{
  "name": "sista-bussen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SISTA BUSSEN - survivor-like mobile web game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:docker-check": "docker build --no-cache -t sista-bussen:docker-check .",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
